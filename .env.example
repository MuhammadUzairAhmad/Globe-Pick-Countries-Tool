# Local previews stay noindex without a configured public HTTPS origin.
# Before public deployment, set this to the actual origin and rebuild.
# NEXT_PUBLIC_SITE_URL=https://your-owned-domain.example

# Public launch checklist inputs (fill these when hosting is selected).
# Also update the public About/privacy/terms content with the real details.
# GLOBEPICK_OPERATOR_NAME=
# GLOBEPICK_CORRECTIONS_URL=
# GLOBEPICK_HOSTING_PROVIDER=
# Set only after reviewing and updating policies for the actual hosting setup.
# GLOBEPICK_POLICIES_REVIEWED=true
